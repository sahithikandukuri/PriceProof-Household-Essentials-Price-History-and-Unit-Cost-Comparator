# =============================================================
# PriceProof — .gitignore
# Protects secrets, dependencies, and generated files
# =============================================================

# -----------------------------------------------
# SECRETS & ENVIRONMENT VARIABLES  ← CRITICAL
# -----------------------------------------------
.env
.env.*
!.env.example
!.env.sample

# Catch any plaintext files accidentally named after secrets
*SERVICE_ROLE_KEY*
*service_role*
*SUPABASE_KEY*
*supabase_key*
*.pem
*.key
*.p12
*.pfx
*.crt
service-account*.json
credentials*.json

# -----------------------------------------------
# NODE.JS DEPENDENCIES
# -----------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -----------------------------------------------
# BUILD OUTPUTS & CACHES
# -----------------------------------------------
dist/
build/
out/
.cache/
.parcel-cache/
.turbo/
.temp/
tmp/
temp/
coverage/

# -----------------------------------------------
# LOGS
# -----------------------------------------------
*.log
logs/

# -----------------------------------------------
# OPERATING SYSTEM FILES
# -----------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# -----------------------------------------------
# EDITOR & IDE FILES
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.suo
*.user
*.userosscache
*.sln.docstates

# -----------------------------------------------
# LOCAL DATABASE FILES & DUMPS
# -----------------------------------------------
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz

# -----------------------------------------------
# TEST ARTIFACTS
# -----------------------------------------------
playwright-report/
test-results/

# -----------------------------------------------
# DEPLOYMENT TOOLS (local state only)
# -----------------------------------------------
.vercel/
.netlify/

# -----------------------------------------------
# DO NOT IGNORE (source files to keep)
# -----------------------------------------------
# package-lock.json  ← tracked intentionally (reproducible installs)
# supabase/migrations/  ← schema source, not secrets
# supabase/seed.sql  ← seed data, not secrets
# .env.example  ← placeholder template, safe to commit
